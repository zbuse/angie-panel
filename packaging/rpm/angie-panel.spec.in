Name:           angie-panel
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Web configurator for the Angie reverse proxy
License:        MIT AND GPL-3.0-or-later
URL:            https://github.com/maxname/angie-panel
BuildArch:      %{_target_cpu}

Requires:       angie >= 1.12
Requires:       bash
Requires:       curl
Requires:       dbus
Requires:       polkit
Requires:       shadow-utils
Requires:       systemd

%description
Angie Panel is a web UI for configuring Angie reverse proxy hosts, certificates,
streams, and related settings. It runs as an unprivileged systemd service.

%prep

%build

%install
install -D -m 0755 %{_sourcedir}/angie-panel %{buildroot}%{_bindir}/angie-panel
install -D -m 0755 %{_sourcedir}/apctl %{buildroot}%{_bindir}/apctl
install -D -m 0644 %{_sourcedir}/angie-panel.toml %{buildroot}%{_sysconfdir}/angie-panel.toml
install -D -m 0644 %{_sourcedir}/LICENSE %{buildroot}%{_datadir}/licenses/angie-panel/LICENSE

install -D -m 0644 %{_sourcedir}/angie-panel.service %{buildroot}%{_prefix}/lib/systemd/system/angie-panel.service
install -D -m 0644 %{_sourcedir}/angie-panel-configtest.service %{buildroot}%{_prefix}/lib/systemd/system/angie-panel-configtest.service
install -D -m 0644 %{_sourcedir}/angie-panel-apply.service %{buildroot}%{_prefix}/lib/systemd/system/angie-panel-apply.service
install -D -m 0644 %{_sourcedir}/angie-panel-enable-streams.service %{buildroot}%{_prefix}/lib/systemd/system/angie-panel-enable-streams.service
install -D -m 0644 %{_sourcedir}/10-angie-panel.rules %{buildroot}%{_datadir}/polkit-1/rules.d/10-angie-panel.rules
install -D -m 0644 %{_sourcedir}/angie-panel.conf %{buildroot}%{_prefix}/lib/tmpfiles.d/angie-panel.conf

install -D -m 0644 %{_sourcedir}/block-exploits.conf %{buildroot}%{_datadir}/angie-panel/snippets/block-exploits.conf
install -D -m 0644 %{_sourcedir}/cache-assets.conf %{buildroot}%{_datadir}/angie-panel/snippets/cache-assets.conf
install -D -m 0644 %{_sourcedir}/geoip-countries.csv %{buildroot}%{_datadir}/angie-panel/geoip-countries.csv
install -D -m 0755 %{_sourcedir}/acme.sh %{buildroot}%{_datadir}/angie-panel/acme.sh/acme.sh
install -D -m 0644 %{_sourcedir}/VENDOR.txt %{buildroot}%{_datadir}/angie-panel/acme.sh/VENDOR.txt
install -d -m 0755 %{buildroot}%{_datadir}/angie-panel/acme.sh/dnsapi
install -m 0644 %{_sourcedir}/dnsapi/*.sh %{buildroot}%{_datadir}/angie-panel/acme.sh/dnsapi/

install -D -m 0644 %{_sourcedir}/angie-panel.1 %{buildroot}%{_mandir}/man1/angie-panel.1
install -D -m 0644 %{_sourcedir}/apctl.1 %{buildroot}%{_mandir}/man1/apctl.1
install -D -m 0644 %{_sourcedir}/apctl.bash %{buildroot}%{_datadir}/bash-completion/completions/apctl
install -D -m 0644 %{_sourcedir}/angie-panel.bash %{buildroot}%{_datadir}/bash-completion/completions/angie-panel
install -D -m 0644 %{_sourcedir}/_apctl %{buildroot}%{_datadir}/zsh/site-functions/_apctl
install -D -m 0644 %{_sourcedir}/_angie-panel %{buildroot}%{_datadir}/zsh/site-functions/_angie-panel
install -D -m 0644 %{_sourcedir}/apctl.fish %{buildroot}%{_datadir}/fish/vendor_completions.d/apctl.fish

%pre
if ! getent passwd angie-panel >/dev/null; then
    useradd --system --no-create-home --home-dir /var/lib/angie-panel \
        --shell /sbin/nologin --comment "angie-panel service" angie-panel
fi

%post
install -d -o angie-panel -g angie-panel -m 0700 /var/lib/angie-panel
install -d -o angie-panel -g angie-panel -m 0755 /var/lib/angie-panel/public
if getent passwd angie >/dev/null; then
    install -d -o angie -g angie -m 0750 /var/cache/angie-panel-assets
else
    install -d -m 0750 /var/cache/angie-panel-assets
fi
/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/angie-panel.conf
if [ -d /run/systemd/system ]; then
    /usr/bin/systemctl daemon-reload >/dev/null
    /usr/bin/systemctl enable angie-panel.service >/dev/null || :
    if [ "$1" -gt 1 ]; then
        /usr/bin/systemctl try-restart angie-panel.service >/dev/null || :
    fi
fi

%preun
if [ "$1" -eq 0 ] && [ -d /run/systemd/system ]; then
    /usr/bin/systemctl disable --now angie-panel.service >/dev/null || :
fi

%postun
if [ -d /run/systemd/system ]; then
    /usr/bin/systemctl daemon-reload >/dev/null || :
fi

%files
%{_bindir}/angie-panel
%{_bindir}/apctl
%license %{_datadir}/licenses/angie-panel/LICENSE
%config(noreplace) %{_sysconfdir}/angie-panel.toml
%{_prefix}/lib/systemd/system/angie-panel.service
%{_prefix}/lib/systemd/system/angie-panel-configtest.service
%{_prefix}/lib/systemd/system/angie-panel-apply.service
%{_prefix}/lib/systemd/system/angie-panel-enable-streams.service
%{_datadir}/polkit-1/rules.d/10-angie-panel.rules
%{_prefix}/lib/tmpfiles.d/angie-panel.conf
%{_datadir}/angie-panel
%{_mandir}/man1/angie-panel.1*
%{_mandir}/man1/apctl.1*
%{_datadir}/bash-completion/completions/apctl
%{_datadir}/bash-completion/completions/angie-panel
%{_datadir}/zsh/site-functions/_apctl
%{_datadir}/zsh/site-functions/_angie-panel
%{_datadir}/fish/vendor_completions.d/apctl.fish

%changelog
* Mon Nov 09 2026 Angie Panel contributors
- Initial RPM package
